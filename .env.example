NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY_HOPS=0
LOG_LEVEL=info
POSTGRES_DB=timetable_admin
POSTGRES_USER=admin_backend
POSTGRES_PASSWORD=REPLACE_ME
# Run npm run setup:local to generate local secrets. Never use placeholders in production.
DATABASE_URL=postgresql://admin_backend:REPLACE_ME@127.0.0.1:5434/timetable_admin
SESSION_PEPPER=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
PII_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS
# Optional Compose overrides; defaults avoid the native API/database ports.
# DOCKER_API_PORT=3001
# DOCKER_DB_PORT=5435
# DOCKER_API_NODE_ENV=development
