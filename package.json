{
  "name": "admin-dashboard",
  "version": "1.0.0",
  "description": "Backend-only capstone untuk memantau penggunaan Camera Assist per stasiun dan mengelola alert kegagalan kamera oleh petugas keamanan.",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:docker": "node scripts/test-docker.cjs",
    "setup:local": "node scripts/setup-local.cjs",
    "postman:validate": "node postman/validate.cjs",
    "postman:health": "node scripts/test-health.cjs",
    "postman:docker": "node scripts/test-health.cjs --docker",
    "db:start": "node scripts/local-postgres.cjs start",
    "db:stop": "node scripts/local-postgres.cjs stop",
    "db:status": "node scripts/local-postgres.cjs status",
    "setup:demo": "node scripts/setup-demo.cjs",
    "prisma:generate": "prisma generate --config prisma.config.ts",
    "prisma:validate": "prisma validate --config prisma.config.ts",
    "prisma:migrate": "prisma migrate deploy --config prisma.config.ts",
    "prisma:status": "prisma migrate status --config prisma.config.ts",
    "prisma:seed": "node --env-file=.env --env-file=.env.seed.local --import tsx prisma/seed.ts",
    "docker:config": "docker compose config --quiet",
    "docker:build": "docker compose build api migrate",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api migrate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "pg": "8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "lodash": "4.18.1",
    "handlebars": "4.7.10"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/supertest": "^7.2.1",
    "newman": "^6.2.3",
    "prisma": "7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
