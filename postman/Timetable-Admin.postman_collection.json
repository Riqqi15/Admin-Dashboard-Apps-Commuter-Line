{
  "info": {
    "name": "Timetable Admin API — DRAFT",
    "description": "Starter pengujian backend capstone. Endpoint health sudah diimplementasikan dan diuji melalui Newman; endpoint bisnis masih draft. Endpoint mengikuti docs/api-specification.md; asumsi schema/header dicatat di postman/README.md. Jalankan alur penuh hanya setelah backend bisnis dan fixture siap.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Health Check",
      "item": [
        {
          "name": "01 Backend hidup",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{baseUrl}}/health",
            "description": "Liveness API tanpa query database. Memeriksa status, JSON, response body, dan security header."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Backend hidup: HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Content-Type JSON\", () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test(\"Liveness response sesuai kontrak\", () => pm.expect(pm.response.json()).to.eql({success: true, data: {status: 'ok'}}));",
                  "pm.test(\"Security header nosniff\", () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01b Database Readiness",
      "item": [
        {
          "name": "Database PostgreSQL siap",
          "request": {
            "method": "GET",
            "header": [ { "key": "Accept", "value": "application/json" }, { "key": "Origin", "value": "{{origin}}" } ],
            "url": "{{baseUrl}}/health/ready",
            "description": "Memeriksa koneksi PostgreSQL melalui query SELECT 1. HTTP 503 bila database tidak tersedia."
          },
          "event": [ { "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Database ready: HTTP 200', () => pm.response.to.have.status(200));",
            "pm.test('Readiness JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
            "pm.test('PostgreSQL terhubung', () => pm.expect(pm.response.json()).to.eql({success:true,data:{status:'ready',database:'connected'}}));"
          ] } } ]
        }
      ]
    },
    {
      "name": "02 Authentication",
      "item": [
        {
          "name": "02 Login Super Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}{{apiPath}}/auth/login",
            "description": "Menggunakan cookie sesi, bukan Bearer token. Draft mengasumsikan token di data.csrfToken; ubah csrfResponseField jika kontrak implementasi berbeda. Cookie dikelola otomatis oleh Postman.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{superAdminUsername}}\",\n  \"password\": \"{{superAdminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset(\"csrfToken\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.expect(pm.response.code).to.be.oneOf([200]));",
                  "pm.test(\"Response JSON sesuai kontrak\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "});",
                  "if (pm.response.code === 200) {",
                  "  const token = pm.response.json().data[pm.environment.get(\"csrfResponseField\")];",
                  "  pm.test(\"Login mengembalikan CSRF token\", () => pm.expect(token).to.be.a(\"string\").and.not.empty);",
                  "  if (typeof token === \"string\" && token) pm.environment.set(\"csrfToken\", token);",
                  "}"
                ]
              }
            }
          ]
        },
